# Identificadores públicos: obtenerlos de Autoclick-Cloud/deployment.json.
# Usar WebClientId para la web, no DesktopClientId. No agregar secretos aquí.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=copy-UserPoolId-from-cloud-stack
NEXT_PUBLIC_COGNITO_CLIENT_ID=copy-WebClientId-from-cloud-stack
NEXT_PUBLIC_AUTOCLICK_API_URL=https://copy-ApiUrl-from-cloud-stack
