# Perfil opcional del backend de IA en un servidor con Docker/Dokploy.
# Para evaluar en Windows, usar Start-AutoClick.ps1 y Autoclick-IA/.env.example.
# Build path /; Dockerfile Autoclick-IA/deploy/Dockerfile; context .
# Configurar un dominio HTTPS propio hacia el puerto 8001 del contenedor.
# Named volume autoclick-ia-data -> /var/lib/autoclick; one replica.
# Set these values in Dokploy Environment, never in the image or desktop ZIP.
AUTOCLICK_AI_HOST=0.0.0.0
AUTOCLICK_AI_PORT=8001
AUTOCLICK_AI_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173
AUTOCLICK_CLOUD_API_URL=https://REPLACE_WITH_CLOUD_CONTROL_API
AUTOCLICK_CLOUD_REGION=us-east-1
AUTOCLICK_CLOUD_CONCURRENCY=1
AUTOCLICK_CLOUD_OUTBOX=/var/lib/autoclick/usage-outbox.sqlite3
# URL alcanzable desde el contenedor. Ejemplo para Ollama en el host de Docker Desktop.
# En otra maquina, usar su direccion privada. localhost seria el propio contenedor.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=autoclick-8b:entrega33
OLLAMA_FALLBACK_MODEL=qwen3.6:27b
# AutoClick 8B ajustado primero; Qwen 27B como respaldo en el mismo Ollama.
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=3407
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_THINK=false
OLLAMA_FALLBACK_START_TIMEOUT_SECONDS=120
AUTOCLICK_AI_STRUCTURED_TOOLS=false
AUTOCLICK_AI_PLAN_NATURAL_DRAFTS=true
AUTOCLICK_AI_REVIEW_DRAFTS=true
AUTOCLICK_AI_GROUNDED_EDIT_SUMMARIES=true
AUTOCLICK_AI_GROUNDED_CREATION_SUMMARIES=true
AUTOCLICK_AI_RECIPE_ATTEMPTS=3
AUTOCLICK_AI_HOME_TIMEOUT_SECONDS=300
AUTOCLICK_AI_EDITOR_TIMEOUT_SECONDS=300
AUTOCLICK_AI_GENERATION_TIMEOUT_SECONDS=300
# Base64 of the existing worker certificate and worker key.
# Never use the certificate authority private key here.
WORKER_CERT_B64=
WORKER_KEY_B64=
WORKER_TRUST_ANCHOR_ARN=
WORKER_PROFILE_ARN=
WORKER_ROLE_ARN=
# Instalar ambos modelos en el servidor Ollama indicado por OLLAMA_BASE_URL.
# Para usar este backend remoto, configurar VITE_AUTOCLICK_AI_URL con su URL HTTPS.
# Local development can keep its own .env files and localhost URL.
