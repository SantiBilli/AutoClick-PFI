# Perfil de ejemplo: AutoClick 8B ajustado como principal y Qwen 27B como respaldo.
# Requiere ambos modelos instalados en el servidor Ollama elegido.
# La selección efectiva se define en .env, que no se sobrescribe al iniciar.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=autoclick-8b:entrega33
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=3407
AUTOCLICK_AI_STRUCTURED_TOOLS=false
AUTOCLICK_AI_PLAN_NATURAL_DRAFTS=true
AUTOCLICK_AI_REVIEW_DRAFTS=true
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_THINK=false

# Alternativa: Ollama en otra maquina accesible por una red privada o VPN.
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# El worker protegido usa .env.cloud generado por
# Start-AutoClick.ps1, con AUTOCLICK_CLOUD_API_URL,
# AUTOCLICK_CLOUD_REGION, AUTOCLICK_CLOUD_AWS_PROFILE, AUTOCLICK_AI_HOST,
# AUTOCLICK_AI_PORT y AUTOCLICK_AI_ALLOWED_ORIGINS. No poner claves aquí.
# Los límites y tiempos predeterminados están definidos en app/config.py.
OLLAMA_FALLBACK_MODEL=qwen3.6:27b
OLLAMA_FALLBACK_START_TIMEOUT_SECONDS=120
AUTOCLICK_AI_GROUNDED_EDIT_SUMMARIES=true
AUTOCLICK_AI_GROUNDED_CREATION_SUMMARIES=true
AUTOCLICK_AI_RECIPE_ATTEMPTS=3
AUTOCLICK_AI_HOME_TIMEOUT_SECONDS=300
AUTOCLICK_AI_EDITOR_TIMEOUT_SECONDS=300
AUTOCLICK_AI_GENERATION_TIMEOUT_SECONDS=300
